{
    "kind": "collectionType",
    "collectionName": "faqs",
    "info": {
        "singularName": "faq",
        "pluralName": "faqs",
        "displayName": "FAQ",
        "description": "FAQ sections"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "question": {
            "type": "string",
            "required": true
        },
        "answer": {
            "type": "richtext",
            "required": true
        },
        "category": {
            "type": "enumeration",
            "enum": ["General", "Visa", "Points", "Consultation"]
        },
        "sort_order": {
            "type": "integer"
        },
        "persona": {
            "type": "enumeration",
            "enum": ["Skilled", "Student", "Graduate", "All"]
        }
    }
}
