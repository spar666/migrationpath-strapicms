# ─── Server ───
HOST=0.0.0.0
PORT=1337

# ─── App Keys (generate with: openssl rand -base64 16) ───
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Database (PostgreSQL) ───
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/migration_db
DATABASE_SSL=false

# ─── For local SQLite development (uncomment and set DATABASE_CLIENT=sqlite) ───
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
